# @defaultRequired=infer @defaultSensitive=false
# ---

# Selects deterministic local analysis or the live OpenAI route.
# @public @type=enum(mock, live)
MAC_ANALYSIS_MODE=mock

# Global server analysis shutdown. Local browser rehearsal is unaffected.
MAC_LIVE_ANALYSIS_ENABLED=false

# The model used only when MAC_ANALYSIS_MODE=live.
# @public
OPENAI_MODEL=gpt-5.6-sol

# Required at runtime only for live analysis. Keep the value in a gitignored local override or secret provider.
# @sensitive @optional @type=string(startsWith=sk-)
OPENAI_API_KEY=

# Required to enable /api/analyze. The route returns 503 while unset and 401 without a matching bearer token.
# Used only by the non-production static invite policy.
# @sensitive @optional @type=string(minLength=24)
MAC_BENCH_ACCESS_TOKEN=

# Selects fail-closed invite access, a local static code, or the Upstash production adapter.
# @public @type=enum(disabled, static, upstash)
MAC_INVITE_POLICY=disabled

# Keyed hashing secret for invite codes and IP addresses. Never expose this to the browser.
# @sensitive @optional @type=string(minLength=32)
MAC_INVITE_HASH_PEPPER=

# Default local-static run allowance. Upstash invitations carry their own maxRuns value.
# @public @type=number
MAC_INVITE_MAX_RUNS=20

# Default per-paper character allowance for local-static analysis.
# @public @type=number
MAC_INVITE_MAX_INPUT_CHARACTERS=200000

# Per-IP live-analysis attempts allowed in each ten-minute window.
# @public @type=number
MAC_INVITE_IP_REQUESTS=10

# Injected by the Upstash Redis Vercel Marketplace integration.
# @sensitive @optional @type=url
UPSTASH_REDIS_REST_URL=

# Injected by the Upstash Redis Vercel Marketplace integration.
# @sensitive @optional
UPSTASH_REDIS_REST_TOKEN=

# When true, the browser calls /api/analyze. When false, it runs the deterministic local apparatus rehearsal.
# @public @type=boolean
VITE_USE_ANALYSIS_API=false

# Unused Atlas leftover. No in-repo reader after appConfig was removed.
# Kept as a public contract key until a human confirms it can be dropped.
# @public
VITE_APP_TITLE=C-Atlas

# Unused Atlas leftover. No in-repo reader after appConfig was removed.
# Kept as a public contract key until a human confirms it can be dropped.
# @public
VITE_APP_VERSION=1.0.0

# Unused Atlas leftover. No in-repo reader after appConfig was removed.
# Kept as a public contract key until a human confirms it can be dropped.
# @public
VITE_CHART_THEME=dark

# Unused Atlas leftover. No in-repo reader after appConfig was removed.
# Kept as a public contract key until a human confirms it can be dropped.
# @public @type=enum(svg, canvas)
VITE_CHART_RENDERER=svg

# Unused Atlas leftover. No in-repo reader after appConfig was removed.
# Kept as a public contract key until a human confirms it can be dropped.
# @public @type=url
VITE_API_BASE_URL=http://localhost:3000

# Optional Mixpanel project token. Public because Vite inlines VITE_* into the browser bundle.
# Analytics stay disabled when unset, and the client only initializes Mixpanel in production builds.
# @public @optional
VITE_MIXPANEL_TOKEN=

# Server credential for the /api/submit Telegram feedback route. Required only when forwarding is enabled.
# Keep the value in a gitignored local override or secret provider.
# @sensitive @optional
TG_BOT_TOKEN=

# Server credential naming the Telegram chat that receives feedback. Required only with TG_BOT_TOKEN.
# Keep the value in a gitignored local override or secret provider.
# @sensitive @optional
TG_CHAT_ID=

# Optional sitemap origin for scripts/generate-sitemap.js. Leave unset so this contract does not ship a production URL.
# @public @optional @type=url
SITE_URL=

# Platform-provided Vercel commit SHA. Vite inlines it as __SOURCE_COMMIT__ and falls back to local-uncommitted when unset.
# @public @optional
VERCEL_GIT_COMMIT_SHA=

# Platform-provided Vercel deployment context. Static invite policy refuses production.
# @public @optional @type=enum(production, preview, development)
VERCEL_ENV=

# Optional git ref for scripts/validate-benchmark-registry.ts history checks. Unset skips that comparison.
# @public @optional
CHALLENGE_BASE_REF=

# Platform-provided Node/Vite build mode. vite.config.ts inlines it with a production fallback.
# @public @optional
NODE_ENV=

# Platform-provided Vite production flag (import.meta.env.PROD). Mixpanel initializes only when this is true.
# @public @optional @type=boolean
PROD=

# Platform-provided CI runner flag. Playwright uses it only to increase retries.
# @public @optional @type=boolean
CI=
